NODE_ENV=development
PORT=8000
APP_ORIGIN=http://localhost:8000
PAYNEXIS_LAUNCH_AT=2026-10-21T15:00:00Z
# PostgreSQL connection with TLS required in production (sslmode=verify-full).
DATABASE_URL=
# Generate at least 32 random bytes. Never put this in public configuration.
SESSION_SECRET=
# Reputable OIDC provider: enable signup, email verification, MFA and recovery there.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Register APP_ORIGIN/auth/callback as the exact provider callback.
# Optional card payment adapter. Remains disabled until acceptance tested and enabled.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# On-chain transactions are NOT implemented/enabled. These are readiness metadata only.
ROBINHOOD_RPC_URL=
ROBINHOOD_CHAIN_ID=
ROBINHOOD_EXPLORER_URL=
# Verified token metadata is configured privately in admin; no ticker assumed.
